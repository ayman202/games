datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GameStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  HIDDEN
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  MODERATOR
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Game {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  description     String     // rich text HTML
  overview        String?    // optional short summary, shown before the main description
  note            String?    // optional callout note (e.g. install instructions, warnings)
  coverImage      String?
  version         String?
  sizeLabel       String?
  status          GameStatus @default(PUBLISHED)
  publishAt       DateTime?
  metaTitle       String?
  metaDescription String?
  videoUrl        String?
  systemRequirements String? // JSON string: { os, cpu, gpu, ram, storage, extra: [{label,value}] }
  views           Int        @default(0)
  downloadCount   Int        @default(0)
  avgRating       Float      @default(0)
  ratingCount     Int        @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links       DownloadLink[]
  images      GameImage[]
  tags        GameTag[]
  favoritedBy Favorite[]
  reviews     Review[]
  reports     Report[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  image     String?
  order     Int      @default(0)
  games     Game[]
  createdAt DateTime @default(now())
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  games GameTag[]
}

model GameTag {
  gameId String
  tagId  String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
}

model GameImage {
  id       String @id @default(cuid())
  url      String
  order    Int    @default(0)
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model DownloadLink {
  id            String    @id @default(cuid())
  label         String
  url           String
  provider      String    @default("direct") // direct, google-drive, mega, mediafire, torrent...
  clicks        Int       @default(0)
  isWorking     Boolean?  // null = not checked yet
  lastCheckedAt DateTime?
  gameId        String
  game          Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  reports       Report[]
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  activity     ActivityLog[]
}

model ActivityLog {
  id          String    @id @default(cuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String    // e.g. "game.create", "game.delete", "user.ban"
  entityType  String?
  entityId    String?
  details     String?
  createdAt   DateTime  @default(now())
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  banned       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
  reviews      Review[]
  reports      Report[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  approved  Boolean  @default(true)
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

model Report {
  id         String       @id @default(cuid())
  reason     String
  message    String?
  status     ReportStatus @default(OPEN)
  gameId     String?
  game       Game?        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  linkId     String?
  link       DownloadLink? @relation(fields: [linkId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int
  createdAt   DateTime @default(now())
}

model DailyStat {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  views     Int      @default(0)
  downloads Int      @default(0)

  @@unique([date])
}

model Redirect {
  id         String @id @default(cuid())
  fromPath   String @unique
  toPath     String
  statusCode Int    @default(301)
}

model Settings {
  id                 String  @id @default("singleton")
  siteName           String  @default("GameHub")
  siteDescription    String? 
  logoUrl            String?
  faviconUrl         String?
  primaryColor       String  @default("#7c5cff")
  secondaryColor     String  @default("#00e5c7")
  backgroundColor    String  @default("#0b0d12")
  surfaceColor       String  @default("#12151c")

  lightPrimaryColor   String  @default("#7c5cff")
  lightSecondaryColor String  @default("#00997f")
  lightBackgroundColor String @default("#f7f7fa")
  lightSurfaceColor   String  @default("#ffffff")

  defaultTheme       String  @default("dark") // dark | light
  allowThemeToggle   Boolean @default(true)
  maintenanceMode    Boolean @default(false)
  allowRegistration  Boolean @default(true)
  allowReviews       Boolean @default(true)
  showGameNotes      Boolean @default(true)
  enableCopyProtection Boolean @default(false)

  heroImageCount     Int     @default(10)
  heroBackgroundColor      String @default("#0b0d12")
  heroBlob1Color           String @default("#7c5cff")
  heroBlob2Color           String @default("#00e5c7")
  heroBackgroundColorLight String @default("#f7f7fa")
  heroBlob1ColorLight      String @default("#7c5cff")
  heroBlob2ColorLight      String @default("#00997f")

  noteColor String @default("#eab308")

  adSlotHomeBetweenRows String?

  downloadWaitSeconds  Int     @default(10)
  adSlotDownloadTop    String?
  adSlotDownloadBottom String?

  socialFacebook     String?
  socialTwitter      String?
  socialInstagram    String?
  socialYoutube      String?
  socialDiscord      String?

  seoDefaultTitle       String?
  seoDefaultDescription String?
  seoKeywords           String?

  showContactInHeader Boolean @default(true)
  showCategoriesInHeader Boolean @default(false)

  footerText  String?

  adSlotHeader       String?
  adSlotSidebar      String?
  adSlotFooter       String?
  adsTxtContent      String?
}

model StaticPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   // rich text HTML
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
