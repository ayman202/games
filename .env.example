# Copy this file to .env and fill in real values before running the app locally.
# (On Vercel, set these as Environment Variables in the project settings instead.)

# A PostgreSQL connection string (Neon, Vercel Postgres/Prisma Postgres, Railway, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname"

# The first Super Admin account, created by `npm run seed`.
ADMIN_EMAIL="admin@example.com"
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=""

# Random long string used to sign admin and visitor session tokens.
SESSION_SECRET="change-this-to-a-long-random-string"

# Public URL of the deployed site, used for the sitemap and robots.txt.
SITE_URL="http://localhost:3000"
